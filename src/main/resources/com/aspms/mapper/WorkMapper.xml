<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aspms.mapper.WorkMapper">

	<!-- 添加工作信息 -->
    <insert id="doAddWorkInfo" parameterType="Work">
		insert into `t_work`(`uid`,`data`,`remarks`,`worklist`,`time`,`photo`) values (#{uid},#{data},#{remarks},#{worklist},#{time},#{photo})
	</insert>

	<!-- 修改工作信息 -->
	<update id="doModifyWorkInfo" parameterType="Work">
		update `t_work` set `uid`=#{uid},`data`=#{data},`remarks`=#{remarks},`worklist`=#{worklist},`time`=#{time},`photo`=#{photo} where `wid`=#{wid}
	</update>

	<!-- 删除工作信息 -->
	<delete id="doDeleteWorkInfo" parameterType="Work">
		delete from `t_work` where `wid`=#{wid}
	</delete>

	<!-- 获取工作信息 -->
	<select id="doGetWorkInfo" parameterType="Work" resultType="Work">
		select * from `t_work` where `wid`=#{wid} or `uid`=#{uid}
	</select>

	<!-- 获取工作列表 -->
	<select id="doGetWorkInfoList" resultType="Work">
		select * from `t_work`
	</select>

	<!-- 获取工作列表 -->
	<select id="doGetWorkInfoListByuid" resultType="Work">
		select * from `t_work` where `uid`=#{uid}
	</select>


</mapper>
